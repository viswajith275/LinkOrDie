package components

import "link_or_die/internal/domains/auth"


templ Login(view auth.LoginView) {
    <html>
        <body>
            <h1>Login</h1>
            if view.Error != "" {
                <p class="error">{ view.Error }</p>
            }
            <form method="POST" action="/login">
                <input name="username" value={ view.Username } placeholder="Username"/>
                <input name="password" type="password" placeholder="Password"/>
                <button type="submit">Login</button>
            </form>
            <hr/>
            <a href="/auth/google">Login with Google</a>
        </body>
    </html>
}
