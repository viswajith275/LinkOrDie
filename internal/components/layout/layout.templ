package layout

import (
	"link_or_die/internal/components/navbar"
	"link_or_die/internal/components/ui"
)

templ documentHead(title string) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>{ title } · LinkOrDie</title>
		<script src="https://unpkg.com/htmx.org@2.0.4"></script>
		<style>
			:root { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; line-height: 1.5; color: #17202a; background: #f7f8fa; }
			* { box-sizing: border-box; }
			body { margin: 0; }
			a { color: #0b5cad; }
			.container { width: min(1080px, calc(100% - 2rem)); margin: 0 auto; padding: 1.25rem 0 3rem; }
			.navbar { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; padding: .75rem 1.5rem; background: #fff; border-bottom: 1px solid #dfe3e8; }
			.brand { font-weight: 700; text-decoration: none; color: inherit; }
			.nav-links { display: flex; gap: .75rem; flex-wrap: wrap; }
			.nav-link { text-decoration: none; color: #4a5560; padding: .25rem .4rem; border-radius: .25rem; }
			.nav-link.active { color: #0b5cad; background: #eaf2fc; }
			.nav-user { margin-left: auto; display: flex; align-items: center; gap: .75rem; }
			.page-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
			.page-head h1 { margin: 0 0 .25rem; }
			.page-head p { margin: 0; color: #5b6772; }
			.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: .75rem; }
			.card { background: #fff; border: 1px solid #dfe3e8; border-radius: .5rem; padding: 1rem; }
			.card h2, .card h3 { margin-top: 0; }
			.stat { font-size: 1.75rem; font-weight: 700; }
			.muted { color: #5b6772; }
			.row { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
			.stack > * + * { margin-top: 1rem; }
			table { width: 100%; border-collapse: collapse; background: #fff; }
			th, td { text-align: left; padding: .55rem .6rem; border-bottom: 1px solid #e5e8ec; vertical-align: top; }
			th { background: #f1f3f6; font-size: .85rem; text-transform: uppercase; letter-spacing: .03em; }
			.badge { display: inline-block; border-radius: 999px; padding: .1rem .5rem; font-size: .8rem; font-weight: 600; background: #eceff2; color: #3b4752; }
			.badge-success { background: #e3f5e8; color: #17692c; }
			.badge-warning { background: #fff2d8; color: #7a5200; }
			.badge-danger { background: #fde6e6; color: #9d1d1d; }
			button, .button { font: inherit; cursor: pointer; }
			.button, button[type="submit"] { display: inline-block; border: 1px solid #0b5cad; background: #0b5cad; color: #fff; text-decoration: none; padding: .4rem .75rem; border-radius: .35rem; }
			.button.secondary, button.secondary { background: #fff; color: #0b5cad; }
			.link-button { border: 0; background: none; color: #0b5cad; padding: 0; text-decoration: underline; }
			.icon-button { border: 0; background: none; font-size: 1.25rem; line-height: 1; cursor: pointer; color: #5b6772; }
			form.form { display: grid; gap: .75rem; }
			label { display: grid; gap: .25rem; font-weight: 600; }
			input, select, textarea { font: inherit; padding: .45rem .55rem; border: 1px solid #b9c1ca; border-radius: .35rem; width: 100%; }
			.error-banner { border: 1px solid #e5a3a3; background: #fff4f4; color: #8a1f1f; padding: .75rem 1rem; border-radius: .4rem; }
			.error-banner p, .field-error { margin: .25rem 0 0; }
			.field-error { color: #9d1d1d; font-size: .9rem; }
			.empty-state { border: 1px dashed #c3cad2; border-radius: .5rem; padding: 2rem; text-align: center; color: #5b6772; }
			.tabs { display: flex; gap: .4rem; flex-wrap: wrap; margin-bottom: .75rem; }
			.tabs a { padding: .25rem .55rem; border: 1px solid #c9d0d8; border-radius: 999px; text-decoration: none; color: #3b4752; }
			.tabs a.active { background: #0b5cad; border-color: #0b5cad; color: #fff; }
			.modal-backdrop { position: fixed; inset: 0; background: rgba(15, 23, 32, .45); display: grid; place-items: center; padding: 1rem; z-index: 20; }
			.modal { background: #fff; border-radius: .6rem; width: min(520px, 100%); max-height: 90vh; overflow: auto; padding: 1rem 1.25rem 1.25rem; }
			.modal-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
			.modal-head h2 { margin: 0; }
			.toasts { position: fixed; right: 1rem; bottom: 1rem; display: grid; gap: .5rem; z-index: 30; }
			.toast { background: #17202a; color: #fff; border-radius: .4rem; padding: .6rem .75rem; display: flex; align-items: center; gap: .75rem; }
			.toast-success { background: #17692c; }
			.toast-danger { background: #9d1d1d; }
			.toast .icon-button { color: inherit; }
			.htmx-indicator { opacity: 0; transition: opacity .15s ease; }
			.htmx-request .htmx-indicator, .htmx-request.htmx-indicator { opacity: 1; }
			.auth-shell { min-height: 100vh; display: grid; place-items: center; padding: 1rem; }
			.auth-card { width: min(420px, 100%); background: #fff; border: 1px solid #dfe3e8; border-radius: .5rem; padding: 1.5rem; }
			.hero { padding: 4rem 0 2rem; text-align: center; }
			.hero h1 { font-size: clamp(2rem, 6vw, 4rem); margin: 0 0 .5rem; }
			.feature-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
			.tombstone { border-left: 4px solid #9d1d1d; }
			dl { display: grid; grid-template-columns: max-content 1fr; gap: .35rem .9rem; }
			dt { font-weight: 600; }
			dd { margin: 0; overflow-wrap: anywhere; }
			.timeline { list-style: none; padding: 0; margin: 0; }
			.timeline li { border-left: 2px solid #dfe3e8; padding: 0 0 .9rem 1rem; position: relative; }
			.timeline li::before { content: ""; position: absolute; left: -.38rem; top: .35rem; width: .7rem; height: .7rem; border-radius: 50%; background: #0b5cad; }
		</style>
	</head>
}

templ App(p AppProps) {
	<html lang="en">
		@documentHead(p.Title)
		<body hx-boost="true" hx-target="#app-shell" hx-swap="outerHTML transition:true" hx-indicator="#global-indicator">
			<div id="app-shell">
				@navbar.Navbar(navbar.Props{UserName: p.UserName, Active: p.Active})
				<main id="app-main" class="container">
					@ui.Loading()
					@p.Content
				</main>
				@ui.ToastHost()
				@ui.ModalHost()
			</div>
		</body>
	</html>
}

templ Auth(p AuthProps) {
	<html lang="en">
		@documentHead(p.Title)
		<body>
			<main class="auth-shell">
				<div class="auth-card">
					@p.Content
				</div>
			</main>
		</body>
	</html>
}

templ Bare(p BareProps) {
	<html lang="en">
		@documentHead(p.Title)
		<body>
			<main class="container">
				@p.Content
			</main>
		</body>
	</html>
}
