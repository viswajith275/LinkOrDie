package components

import "link_or_die/internals/domains/user"


templ Register(view user.RegisterView) {
    <html>
        <body>
            <h1>Register</h1>
            if view.Error != "" {
                <p class="error">{ view.Error }</p>
            }
            <form method="POST" action="/register">
                <input name="username" value={ view.Username } placeholder="Username"/>
                <input name="email" value={ view.Email } placeholder="Email"/>
                <input name="password" type="password" placeholder="Password"/>
                <button type="submit">Register</button>
            </form>
            <hr/>
            <a href="/auth/google">Login with Google</a>
        </body>
    </html>
}
