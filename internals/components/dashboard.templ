package components

import "link_or_die/internals/domains/dashboard"



templ Dashboard(view dashboard.DashboardView) {
    <html>
        <body>
            <h1>Dashboard</h1>
            <h4>Hello  { view.UserName }</h4>
            <p>Email { view.Email }</p>

            <form method="POST" action="/logout">
            <button type="submit">Logout</button>
            </form>
            </body>
    </html>
}
